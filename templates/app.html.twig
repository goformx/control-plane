<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard — GoFormX</title><style>:root{color-scheme:dark;font-family:Inter,system-ui;background:#09100e;color:#f2f7f4}body{margin:0}header,main{width:min(68rem,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 0;border-bottom:1px solid #294238}main{padding:4rem 0}button,a{color:#7dd3af;background:none;border:1px solid #31564a;border-radius:999px;padding:.65rem .9rem;text-decoration:none}section{margin-top:2rem;padding:1.5rem;border:1px solid #294238;border-radius:1rem;background:#101b17}#error{color:#ffb4a9}</style></head><body><header><strong>GoFormX</strong><button id="logout">Sign out</button></header><main><p>Active workspace</p><h1 id="organization">Loading…</h1><p id="role"></p><p id="error" role="alert"></p><section><h2>Forms and submissions are next</h2><p>The account and ownership boundary is active. The Go data-plane management contract will populate this dashboard without exposing a service credential to the browser.</p></section></main><script>
const csrf=()=>decodeURIComponent((document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/)||[])[1]||'');const organizationElement=document.getElementById('organization'),roleElement=document.getElementById('role'),errorElement=document.getElementById('error'),logoutButton=document.getElementById('logout');fetch('/api/control-plane/context').then(async response=>{const body=await response.json();if(response.status===403){location.href='/verify-email';return}if(!response.ok)throw new Error(body.errors?.[0]?.detail||'Unable to load workspace.');organizationElement.textContent=body.data.attributes.name;roleElement.textContent=body.data.attributes.role;}).catch(e=>errorElement.textContent=e.message);logoutButton.onclick=async()=>{await fetch('/api/auth/logout',{method:'POST',headers:{'X-XSRF-TOKEN':csrf()}});location.href='/';};
</script></body></html>
