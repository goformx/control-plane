<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reset password — GoFormX</title><style>:root{color-scheme:dark;font-family:Inter,system-ui;background:#09100e;color:#f2f7f4}body{margin:0;min-height:100vh;display:grid;place-items:center}main{width:min(28rem,calc(100% - 2rem))}a{color:#7dd3af}input,button{width:100%;padding:.8rem;border-radius:.55rem;border:1px solid #31564a;background:#101b17;color:inherit;margin-top:.5rem}button{background:#7dd3af;color:#07100c;font-weight:700}</style></head><body><main><h1>Reset password</h1><p>Enter your email. We return the same response whether or not an account exists.</p><form id="form"><label for="email">Email</label><input id="email" type="email" autocomplete="email" required><button>Send reset link</button></form><p id="message" role="status"></p><a href="/login">Return to sign in</a></main><script>
const csrf=()=>decodeURIComponent((document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/)||[])[1]||'');const formElement=document.getElementById('form'),emailElement=document.getElementById('email'),messageElement=document.getElementById('message');formElement.addEventListener('submit',async e=>{e.preventDefault();await fetch('/api/auth/forgot-password',{method:'POST',headers:{'Content-Type':'application/json','X-XSRF-TOKEN':csrf()},body:JSON.stringify({email:emailElement.value})});messageElement.textContent='If an account exists, a reset link has been sent.';});
</script></body></html>
