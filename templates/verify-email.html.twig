<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify email — GoFormX</title><style>:root{color-scheme:dark;font-family:Inter,system-ui;background:#09100e;color:#f2f7f4}body{margin:0;min-height:100vh;display:grid;place-items:center}main{width:min(32rem,calc(100% - 2rem))}a{color:#7dd3af}button{padding:.8rem 1rem;border:0;border-radius:.55rem;background:#7dd3af;color:#07100c;font-weight:700}#message{color:#ffb4a9}</style></head><body><main><h1>Verify your email</h1><p>Use the link sent to your email. In local development, copy the token from the application log and add it as <code>?token=…</code>.</p><button id="verify" hidden>Verify email</button><p id="message" role="status"></p><p><a href="/login">Return to sign in</a></p></main><script>
const value=new URLSearchParams(location.search).get('token'),verifyButton=document.getElementById('verify'),messageElement=document.getElementById('message');const csrf=()=>decodeURIComponent((document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/)||[])[1]||'');if(value){verifyButton.hidden=false;verifyButton.onclick=async()=>{const response=await fetch('/api/auth/verify-email',{method:'POST',headers:{'Content-Type':'application/json','X-XSRF-TOKEN':csrf()},body:JSON.stringify({token:value})});if(response.ok){location.href='/app';return}messageElement.textContent='The verification link is invalid or expired.';};}
</script></body></html>
