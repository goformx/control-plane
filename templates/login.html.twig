<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in — GoFormX</title>
<style>:root{color-scheme:dark;font-family:Inter,system-ui;background:#09100e;color:#f2f7f4}body{margin:0;min-height:100vh;display:grid;place-items:center}main{width:min(28rem,calc(100% - 2rem))}a{color:#7dd3af}label{display:block;margin:1rem 0 .35rem}input,button{width:100%;padding:.8rem;border-radius:.55rem;border:1px solid #31564a;background:#101b17;color:inherit}button{margin-top:1.25rem;background:#7dd3af;color:#07100c;font-weight:700}#message{min-height:1.5rem;color:#ffb4a9}</style></head><body><main><a href="/">← GoFormX</a><h1>Sign in</h1><form id="form"><label for="username">Email</label><input id="username" type="email" autocomplete="username" required><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required><button>Sign in</button></form><p id="message" role="status"></p><p><a href="/forgot-password">Forgot password?</a> · <a href="/register">Create account</a></p></main><script>
const token=()=>decodeURIComponent((document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/)||[])[1]||'');const formElement=document.getElementById('form'),usernameElement=document.getElementById('username'),passwordElement=document.getElementById('password'),messageElement=document.getElementById('message');formElement.addEventListener('submit',async e=>{e.preventDefault();messageElement.textContent='';const response=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json','X-XSRF-TOKEN':token()},body:JSON.stringify({username:usernameElement.value,password:passwordElement.value})});const body=await response.json();if(response.ok){location.href='/app';return}messageElement.textContent=body.errors?.[0]?.detail||'Sign in failed.';});
</script></body></html>
