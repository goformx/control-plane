<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account — GoFormX</title>
<style>:root{color-scheme:dark;font-family:Inter,system-ui;background:#09100e;color:#f2f7f4}body{margin:0;min-height:100vh;display:grid;place-items:center}main{width:min(28rem,calc(100% - 2rem))}a{color:#7dd3af}label{display:block;margin:1rem 0 .35rem}input,button{width:100%;padding:.8rem;border-radius:.55rem;border:1px solid #31564a;background:#101b17;color:inherit}button{margin-top:1.25rem;background:#7dd3af;color:#07100c;font-weight:700}#message{min-height:1.5rem;color:#ffb4a9}</style></head><body><main><a href="/">← GoFormX</a><h1>Create your account</h1><p>Start with a personal workspace. Verify your email before opening the dashboard.</p><form id="form"><label for="name">Name</label><input id="name" autocomplete="name" required minlength="2"><label for="email">Email</label><input id="email" type="email" autocomplete="email" required><label for="password">Password</label><input id="password" type="password" autocomplete="new-password" required minlength="8"><button>Create account</button></form><p id="message" role="status"></p><p>Already registered? <a href="/login">Sign in</a>.</p></main><script>
const token=()=>decodeURIComponent((document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/)||[])[1]||'');
const formElement=document.getElementById('form'),nameElement=document.getElementById('name'),emailElement=document.getElementById('email'),passwordElement=document.getElementById('password'),messageElement=document.getElementById('message');
formElement.addEventListener('submit',async e=>{e.preventDefault();messageElement.textContent='';const response=await fetch('/api/auth/register',{method:'POST',headers:{'Content-Type':'application/json','X-XSRF-TOKEN':token()},body:JSON.stringify({name:nameElement.value,email:emailElement.value,password:passwordElement.value})});const body=await response.json();if(response.ok){location.href='/verify-email';return}messageElement.textContent=body.errors?Object.values(body.errors).join(' '):(body.error||'Registration failed.');});
</script></body></html>
