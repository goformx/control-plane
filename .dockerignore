*.db
*.bak
*.sql
.env
.env.*
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.bak
**/*.sql
phpunit.xml.dist
site.answers.yaml
package.json
package-lock.json
composer.local.json
composer.*.json
!composer.json
