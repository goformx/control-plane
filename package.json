{
  "name": "goformx-control-plane-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "check": "node scripts/build-ui.mjs --check && node scripts/check-browser-live.mjs && node --test tests/UI/*.test.mjs",
    "test:browser": "node --test tests/Browser/*.test.mjs",
    "test:live": "node --test tests/BrowserLive/forms-*.test.mjs",
    "test:live:integrations": "node --test tests/BrowserLive/integrations-*.test.mjs",
    "test:live:authorization": "node --test tests/BrowserLive/authorization-*.test.mjs",
    "test:live:failures": "node --test tests/BrowserLive/failures-*.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/state": "6.7.1",
    "codemirror": "6.0.2",
    "lossless-json": "4.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  }
}
