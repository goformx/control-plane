{
    "name": "goformx/control-plane",
    "description": "Human-facing account and management application for GoFormX",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "ext-fileinfo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "ext-sqlite3": "*",
        "ext-zip": "*",
        "symfony/dotenv": "^8.0",
        "waaseyaa/framework": "0.1.0-alpha.299"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "config": {
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "scripts": {
        "audit-site": "./bin/maintenance/waaseyaa-audit-site",
        "check": [
            "@php bin/maintenance/site-verify",
            "@php vendor/bin/phpunit --no-coverage",
            "npm run check",
            "npm run test:browser"
        ],
        "site-verify": "@check",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/waaseyaa dev"
        ],
        "regen-lock": "@composer update 'waaseyaa/*' --no-plugins --no-install --no-scripts",
        "post-create-project-cmd": [
            "php bin/post-create-setup.php"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.site-recipes.json",
                "composer.subscription-recipe.json",
                "composer.local.json"
            ],
            "prepend-repositories": true
        },
        "waaseyaa": {
            "providers": [
                "App\\Provider\\AppServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
